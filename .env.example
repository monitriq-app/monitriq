# Copy this file to .env.local and fill in your Supabase project's values.
# Get these from your Supabase project settings > API.
# Never commit .env.local — it is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Test-harness only (supabase/tests/rls/run.ts) — used to create and clean
# up temporary auth fixture users so the RLS isolation suite can run
# end-to-end. The application itself never reads this variable. Never
# prefix it NEXT_PUBLIC_, never import it from anything under app/ or
# components/, never commit a real value. See
# docs/security/SECURITY_AND_RLS_PRINCIPLES.md #5 and
# supabase/tests/rls/README.md.
SUPABASE_SERVICE_ROLE_KEY=
