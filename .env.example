# Copy this file to .env.local and fill in your Supabase project's values.
# Get these from your Supabase project settings > API.
# Never commit .env.local — it is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key is intentionally not listed here. Nothing in this
# phase uses it. If a future server-only admin use case needs it, it must
# be added as a server-only variable (never NEXT_PUBLIC_*) and never
# referenced from client code. See docs/security/SECURITY_AND_RLS_PRINCIPLES.md.
