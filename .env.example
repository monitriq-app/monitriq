# Copy this file to .env.local and fill in your Supabase project's values.
# Get these from your Supabase project settings > API.
# Never commit .env.local — it is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Test-harness only (supabase/tests/rls/, supabase/tests/money/) — used to
# create and clean up temporary auth fixture users so the isolation suites
# can run end-to-end. The application itself never reads this variable.
# Named SUPABASE_TEST_* (not NEXT_PUBLIC_*) specifically so it's obvious at
# a glance this is not a production/application credential. Never import it
# from anything under app/ or components/, never commit a real value. See
# docs/security/SECURITY_AND_RLS_PRINCIPLES.md #5/#12 and
# supabase/tests/rls/README.md.
SUPABASE_TEST_SERVICE_ROLE_KEY=
