{
  "name": "monatriq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p supabase/tests/tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "test:rls": "node --env-file-if-exists=.env.local supabase/tests/rls/run.ts",
    "test:money": "node --env-file-if-exists=.env.local supabase/tests/money/run.ts",
    "test:currency": "node --env-file-if-exists=.env.local supabase/tests/currency/run.ts",
    "test:assets": "node --env-file-if-exists=.env.local supabase/tests/assets/run.ts",
    "test:receivables": "node --env-file-if-exists=.env.local supabase/tests/receivables/run.ts",
    "test:liabilities": "node --env-file-if-exists=.env.local supabase/tests/liabilities/run.ts",
    "test:goals": "node --env-file-if-exists=.env.local supabase/tests/goals/run.ts",
    "test:rules": "node --env-file-if-exists=.env.local supabase/tests/rules/run.ts",
    "test:decisions": "node --env-file-if-exists=.env.local supabase/tests/decisions/run.ts",
    "test:financial-position": "node --env-file-if-exists=.env.local supabase/tests/financial-position/run.ts",
    "test": "npm run test:rls && npm run test:money && npm run test:currency && npm run test:assets && npm run test:receivables && npm run test:liabilities && npm run test:goals && npm run test:rules && npm run test:decisions && npm run test:financial-position"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "decimal.js": "^10.6.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
