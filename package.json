{
  "name": "monitriq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p supabase/tests/tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "test:rls": "node --env-file-if-exists=.env.test.local supabase/tests/rls/run.ts",
    "test:money": "node --env-file-if-exists=.env.test.local supabase/tests/money/run.ts",
    "test:currency": "node --env-file-if-exists=.env.test.local supabase/tests/currency/run.ts",
    "test:assets": "node --env-file-if-exists=.env.test.local supabase/tests/assets/run.ts",
    "test:receivables": "node --env-file-if-exists=.env.test.local supabase/tests/receivables/run.ts",
    "test:liabilities": "node --env-file-if-exists=.env.test.local supabase/tests/liabilities/run.ts",
    "test:goals": "node --env-file-if-exists=.env.test.local supabase/tests/goals/run.ts",
    "test:rules": "node --env-file-if-exists=.env.test.local supabase/tests/rules/run.ts",
    "test:decisions": "node --env-file-if-exists=.env.test.local supabase/tests/decisions/run.ts",
    "test:financial-position": "node --env-file-if-exists=.env.test.local supabase/tests/financial-position/run.ts",
    "test:home-readiness": "node --env-file-if-exists=.env.test.local supabase/tests/home-readiness/run.ts",
    "test:home": "node --env-file-if-exists=.env.test.local supabase/tests/home/run.ts",
    "test:budget": "node --env-file-if-exists=.env.test.local supabase/tests/budget/run.ts",
    "test:budget-ui": "node --env-file-if-exists=.env.test.local supabase/tests/budget-ui/run.ts",
    "test:core-ui": "node --env-file-if-exists=.env.test.local supabase/tests/core-ui/run.ts",
    "test:spending-check": "node --env-file-if-exists=.env.test.local supabase/tests/spending-check/run.ts",
    "test:app-shell": "node --env-file-if-exists=.env.test.local supabase/tests/app-shell/run.ts",
    "test:cash-status": "node --env-file-if-exists=.env.test.local supabase/tests/cash-status/run.ts",
    "test:language": "node --env-file-if-exists=.env.test.local supabase/tests/language/run.ts",
    "test:home-density": "node --env-file-if-exists=.env.test.local supabase/tests/home-density/run.ts",
    "test:pwa": "node supabase/tests/pwa/run.ts",
    "test:auth-confirm": "node --env-file-if-exists=.env.test.local supabase/tests/auth-confirm/run.ts",
    "test": "npm run test:rls && npm run test:money && npm run test:currency && npm run test:assets && npm run test:receivables && npm run test:liabilities && npm run test:goals && npm run test:rules && npm run test:decisions && npm run test:financial-position && npm run test:home-readiness && npm run test:home && npm run test:budget && npm run test:budget-ui && npm run test:core-ui && npm run test:spending-check && npm run test:app-shell && npm run test:cash-status && npm run test:language && npm run test:home-density && npm run test:pwa && npm run test:auth-confirm"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
